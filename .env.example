# Frontend API URL configuration
# For development, requests go through Vite proxy (see vite.config.ts)
# For production, change this to your Vercel backend URL

# Development (default - uses Vite proxy)
VITE_API_URL=/api

# Production (uncomment and set your Vercel backend URL)
# VITE_API_URL=https://shootly-i1im.vercel.app

